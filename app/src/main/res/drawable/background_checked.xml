<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Rounded corners -->
    <corners android:radius="8dp" />

    <!-- Gradient background -->
    <gradient
        android:startColor="@color/checked_start_color"
        android:endColor="@color/checked_end_color"
        android:angle="45" />

    <!-- Add stroke if desired -->
    <stroke
        android:width="2dp"
        android:color="@color/stroke_color" />
</shape>
